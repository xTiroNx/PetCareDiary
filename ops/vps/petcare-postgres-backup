#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="${BACKUP_DIR:-/var/backups/petcare-postgres}"
POSTGRES_CONTAINER="${POSTGRES_CONTAINER:-petcare-postgres}"
POSTGRES_DB="${POSTGRES_DB:-petcare}"
POSTGRES_USER="${POSTGRES_USER:-petcare}"
RETENTION_DAYS="${RETENTION_DAYS:-14}"

mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
destination="$BACKUP_DIR/petcare-${timestamp}.dump"
temporary="${destination}.tmp"

docker exec "$POSTGRES_CONTAINER" pg_dump \
  -U "$POSTGRES_USER" \
  -d "$POSTGRES_DB" \
  --format=custom \
  --no-owner \
  --no-acl \
  > "$temporary"

test -s "$temporary"
chmod 600 "$temporary"
mv "$temporary" "$destination"

find "$BACKUP_DIR" -type f -name "petcare-*.dump" -mtime "+$RETENTION_DAYS" -delete

echo "Created backup: $destination"
