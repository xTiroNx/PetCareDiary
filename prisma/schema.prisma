generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetType {
  CAT
  DOG
  OTHER
}

enum FoodType {
  DRY
  WET
  NATURAL
  TREAT
  OTHER
}

enum SymptomType {
  VOMITING
  YELLOW_VOMIT
  NO_APPETITE
  DIARRHEA
  CONSTIPATION
  LETHARGY
  PAIN
  OTHER
}

enum ReminderType {
  FEEDING
  MEDICINE
  WATER
  WEIGHT
  VET
  VACCINATION
  OTHER
}

enum PaymentProductType {
  MONTHLY
  SIX_MONTHS
  YEARLY
  LIFETIME
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum VaccinationProcedureType {
  VACCINE
  DEWORMING
  FLEA_TICK
  OTHER
}

enum AccessNotificationType {
  TRIAL_ENDING_SOON
  PAID_ENDING_SOON
  ACCESS_EXPIRED
  PAYMENT_RECEIPT
}

model User {
  id             String          @id @default(cuid())
  telegramId     BigInt          @unique
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  platform       String?
  firstStartParam String?
  lastStartParam  String?
  source          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastSeenAt      DateTime?
  trialStartedAt DateTime
  trialEndsAt    DateTime
  accessUntil    DateTime?
  lifetimeAccess Boolean         @default(false)
  pets           Pet[]
  feedingEntries FeedingEntry[]
  symptomEntries SymptomEntry[]
  medicineEntries MedicineEntry[]
  weightEntries  WeightEntry[]
  noteEntries    NoteEntry[]
  waterEntries   WaterEntry[]
  vaccinationEntries VaccinationEntry[]
  reportExports  ReportExport[]
  reminders      Reminder[]
  payments       Payment[]
  feedback        Feedback[]
  analyticsEvents AnalyticsEvent[]
  accessNotificationLogs AccessNotificationLog[]
}

model Pet {
  id              String          @id @default(cuid())
  userId          String
  name            String
  type            PetType
  weightKg        Decimal?        @db.Decimal(5, 2)
  ageYears        Decimal?        @db.Decimal(4, 1)
  healthNotes     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedingEntries  FeedingEntry[]
  symptomEntries  SymptomEntry[]
  medicineEntries MedicineEntry[]
  weightEntries   WeightEntry[]
  noteEntries     NoteEntry[]
  waterEntries    WaterEntry[]
  vaccinationEntries VaccinationEntry[]
  reportExports   ReportExport[]
  reminders       Reminder[]

  @@index([userId])
}

model FeedingEntry {
  id        String   @id @default(cuid())
  petId     String
  userId    String
  dateTime  DateTime
  foodType  FoodType
  amount    String
  note      String?
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, dateTime])
}

model SymptomEntry {
  id          String      @id @default(cuid())
  petId       String
  userId      String
  dateTime    DateTime
  symptomType SymptomType
  severity    Int
  note        String?
  createdAt   DateTime    @default(now())
  pet         Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, dateTime])
}

model MedicineEntry {
  id           String   @id @default(cuid())
  petId        String
  userId       String
  medicineName String
  dosage       String
  dateTime     DateTime
  taken        Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, dateTime])
}

model WeightEntry {
  id        String   @id @default(cuid())
  petId     String
  userId    String
  date      DateTime
  weightKg  Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, date])
}

model NoteEntry {
  id        String   @id @default(cuid())
  petId     String
  userId    String
  dateTime  DateTime
  note      String
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, dateTime])
}

model WaterEntry {
  id        String   @id @default(cuid())
  petId     String
  userId    String
  dateTime  DateTime
  amountMl  Int
  note      String?
  createdAt DateTime @default(now())
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, dateTime])
}

model VaccinationEntry {
  id            String                   @id @default(cuid())
  petId         String
  userId        String
  procedureType VaccinationProcedureType
  title         String
  date          DateTime
  nextDueDate   DateTime?
  note          String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  pet           Pet                      @relation(fields: [petId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, date])
  @@index([userId, petId, nextDueDate])
}

model ReportExport {
  id        String   @id @default(cuid())
  userId    String
  petId     String
  period    Int
  dayKey    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
}

model Reminder {
  id         String       @id @default(cuid())
  petId      String
  userId     String
  type       ReminderType
  title      String
  time       DateTime
  repeatRule String?
  active     Boolean      @default(true)
  lastSentAt DateTime?
  lastDeliveryError String?
  createdAt  DateTime     @default(now())
  pet        Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, petId, time])
}

model Payment {
  id                      String             @id @default(cuid())
  userId                  String
  productType             PaymentProductType
  amountStars             Int
  currency                String             @default("XTR")
  status                  PaymentStatus      @default(PENDING)
  invoicePayload          String             @unique
  telegramPaymentChargeId String?            @unique
  providerPaymentChargeId String?
  createdAt               DateTime           @default(now())
  paidAt                  DateTime?
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Feedback {
  id                    String    @id @default(cuid())
  userId                String
  message               String
  page                  String?
  accessStatus          String
  telegramSentAt        DateTime?
  telegramDeliveryError String?
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  userId       String?
  telegramId   BigInt?
  event        String
  languageCode String?
  platform     String?
  startParam   String?
  source       String?
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([telegramId, createdAt])
  @@index([languageCode, createdAt])
  @@index([platform, createdAt])
  @@index([startParam, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}

model AccessNotificationLog {
  id               String                 @id @default(cuid())
  userId           String
  type             AccessNotificationType
  dayKey           String?
  relatedPaymentId String?
  createdAt        DateTime               @default(now())
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dayKey])
  @@unique([userId, type, relatedPaymentId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}
